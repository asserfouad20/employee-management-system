{
  "version": 2,
  "builds": [
    {
      "src": "ems/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "ems/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/ems/$1"
    }
  ],
  "buildCommand": "cd ems && npm install && npm run build",
  "outputDirectory": "ems/build",
  "installCommand": "cd ems && npm install"
}
